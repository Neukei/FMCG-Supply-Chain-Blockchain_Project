# ==============================================
# FMCG Supply Chain Tracking System
# Environment Variables Template
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Blockchain Configuration ---
# Get a free API key from https://www.alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Your deployer wallet private key (WITHOUT the 0x prefix)
# WARNING: Use a dedicated development wallet. Never use a wallet with real funds.
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here

# Etherscan API key for contract verification (get from https://etherscan.io/apis)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# --- Backend Configuration ---
BACKEND_PORT=3001
DATABASE_PATH=./supply_chain.db

# --- Frontend Configuration ---
VITE_BACKEND_URL=http://localhost:3001
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=0x_deployed_contract_address_here
